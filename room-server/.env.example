# Call Copilot backend config. Copy to .env for local runs; on a host, set these in its dashboard.

PORT=3030
# Set NODE_ENV=production on a host: the server then refuses to start without DATABASE_URL, an https PUBLIC_URL, MAIL_DRIVER=resend and RESEND_API_KEY.
# NODE_ENV=production
# Public https address phones use to join rooms (QR codes). Defaults to this PC's LAN IP.
# PUBLIC_URL=https://toonwide.app

# Shared key built into the desktop app (MAIN_VITE_APP_KEY). Strongly recommended in production.
APP_KEY=

# Live transcription. Needs a Deepgram key with Member (or higher) role, to mint temporary tokens.
DEEPGRAM_API_KEY=

# Preset matching (TypeSafe Jev). Optional: without it the app uses offline matching.
TYPESAFE_API_KEY=

# Set to 1 when running behind a hosting proxy (Render, Railway, nginx) so rate limits see real IPs.
# TRUST_PROXY=1

# Database. Leave unset for local dev (PGlite in .data/). Required in production.
# DATABASE_URL=postgres://user:pass@host:5432/toonwide

# Website address used in email links. Defaults to PUBLIC_URL. Use http://localhost:5174 with `npm run dev` in web/.
# WEB_URL=https://toonwide.app

# Built website folder. Defaults to ../web/dist.
# WEB_DIST=

# Email: console (dev, prints links), outbox (writes MAIL_OUTBOX file), resend (production).
# MAIL_DRIVER=console
# RESEND_API_KEY=
# MAIL_FROM=Toonwide <no-reply@toonwide.app>
