# Call Copilot backend config. Copy to .env for local runs; on a host, set these in its dashboard.

PORT=3030
# Public https address phones use to join rooms (QR codes). Defaults to this PC's LAN IP.
# PUBLIC_URL=https://api.callcopilot.app

# Shared key built into the desktop app (MAIN_VITE_APP_KEY). Strongly recommended in production.
APP_KEY=

# Live transcription. Needs a Deepgram key with Member (or higher) role, to mint temporary tokens.
DEEPGRAM_API_KEY=

# Preset matching (TypeSafe Jev). Optional: without it the app uses offline matching.
TYPESAFE_API_KEY=

# Set to 1 when running behind a hosting proxy (Render, Railway, nginx) so rate limits see real IPs.
# TRUST_PROXY=1
