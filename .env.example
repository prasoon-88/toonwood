# Build-time product config for the desktop app. Copy to .env (or .env.production) and fill in.
# Users of the app never see these; they only enter their own AI API key.

# Your deployed backend (room-server/), e.g. https://api.callcopilot.app
MAIN_VITE_API_URL=http://localhost:3030

# Must match APP_KEY on the backend
MAIN_VITE_APP_KEY=
